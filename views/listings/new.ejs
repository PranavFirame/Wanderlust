<% layout("/layouts/boilerplate") %>

<div class="container py-4">
    <div class="form-wizard-card">
        <div class="mb-4">
            <a href="/listings" class="text-decoration-none text-secondary small">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to listings
            </a>
            <h2 class="mt-2 mb-1">Airbnb your home</h2>
            <p class="text-secondary small">List your unique space on WanderLust and start welcoming guests worldwide.</p>
        </div>

        <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
            <!-- Property Title & Category -->
            <div class="row g-3 mb-3">
                <div class="col-md-7">
                    <label for="title" class="form-label fw-semibold">Listing Title</label>
                    <input 
                        name="listing[title]" 
                        id="title" 
                        placeholder="e.g. Modern Sunset Beach Villa" 
                        type="text" 
                        class="form-control form-control-custom" 
                        required
                    >
                    <div class="invalid-feedback">Please provide an attractive title.</div>
                </div>

                <div class="col-md-5">
                    <label for="category" class="form-label fw-semibold">Category</label>
                    <select id="category" name="listing[category]" class="form-select form-control-custom" required>
                        <option value="" disabled selected>Choose a category</option>
                        <option value="Trending">Trending</option>
                        <option value="Beachfront">Beachfront</option>
                        <option value="Rooms">Rooms</option>
                        <option value="Iconic Cities">Iconic Cities</option>
                        <option value="Mountains">Mountains</option>
                        <option value="Castles">Castles</option>
                        <option value="Amazing pools">Amazing pools</option>
                        <option value="Camping">Camping</option>
                        <option value="Farms">Farms</option>
                        <option value="Arctic">Arctic</option>
                        <option value="Domes">Domes</option>
                        <option value="Boats">Boats</option>
                    </select>
                    <div class="invalid-feedback">Please choose a category.</div>
                </div>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label for="description" class="form-label fw-semibold">Description</label>
                <textarea 
                    name="listing[description]" 
                    id="description" 
                    rows="4" 
                    placeholder="Describe what makes your space special, nearby attractions, and amenities..." 
                    class="form-control form-control-custom" 
                    required
                ></textarea>
                <div class="invalid-feedback">Please enter a detailed description.</div>
            </div>

            <!-- Image Upload & Preview -->
            <div class="mb-4">
                <label for="image" class="form-label fw-semibold">Property Image</label>
                <input 
                    name="listing[image]" 
                    id="image" 
                    type="file" 
                    class="form-control form-control-custom mb-2" 
                    accept="image/*" 
                    onchange="previewImage(event)" 
                >
                <div class="d-flex align-items-center my-2">
                    <hr class="flex-grow-1 my-0">
                    <span class="px-2 text-muted small">OR ENTER IMAGE URL</span>
                    <hr class="flex-grow-1 my-0">
                </div>
                <input 
                    name="listing[imageUrl]" 
                    id="imageUrl" 
                    type="url" 
                    class="form-control form-control-custom" 
                    placeholder="https://images.unsplash.com/... (optional)"
                    oninput="previewImageUrl(this.value)"
                >
                
                <div id="imagePreviewContainer" class="mt-3 d-none">
                    <p class="text-secondary small mb-1">Image Preview:</p>
                    <img id="imagePreview" src="#" alt="Preview" class="rounded-3 shadow-sm" style="max-height: 220px; object-fit: cover;">
                </div>
            </div>

            <!-- Price & Location -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label for="price" class="form-label fw-semibold">Price per night (&#8377;)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light">&#8377;</span>
                        <input 
                            name="listing[price]" 
                            id="price" 
                            placeholder="2500" 
                            type="number" 
                            min="100" 
                            class="form-control form-control-custom" 
                            required
                        >
                    </div>
                    <div class="invalid-feedback">Please provide a valid price.</div>
                </div>

                <div class="col-md-4">
                    <label for="location" class="form-label fw-semibold">City / Location</label>
                    <input 
                        name="listing[location]" 
                        id="location" 
                        placeholder="e.g. Udaipur, Rajasthan" 
                        type="text" 
                        class="form-control form-control-custom" 
                        required
                    >
                    <div class="invalid-feedback">Please specify the location.</div>
                </div>

                <div class="col-md-4">
                    <label for="country" class="form-label fw-semibold">Country</label>
                    <input 
                        name="listing[country]" 
                        id="country" 
                        placeholder="e.g. India" 
                        type="text" 
                        class="form-control form-control-custom" 
                        required
                    >
                    <div class="invalid-feedback">Please specify the country.</div>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="d-flex justify-content-end gap-2">
                <a href="/listings" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                <button class="btn btn-danger btn-auth-submit rounded-pill px-4" style="width: auto;">
                    Publish Listing
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function previewImage(event) {
        const input = event.target;
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const preview = document.getElementById('imagePreview');
                preview.src = e.target.result;
                document.getElementById('imagePreviewContainer').classList.remove('d-none');
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function previewImageUrl(url) {
        if (url && url.trim().length > 10) {
            const preview = document.getElementById('imagePreview');
            preview.src = url.trim();
            document.getElementById('imagePreviewContainer').classList.remove('d-none');
        }
    }
</script>