<% layout("/layouts/boilerplate") %>

<div class="container py-4">
    <div class="form-wizard-card">
        <div class="mb-4">
            <a href="/listings/<%= listing._id %>" class="text-decoration-none text-secondary small">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to listing
            </a>
            <h2 class="mt-2 mb-1">Edit Listing</h2>
            <p class="text-secondary small">Update the information, pricing, or imagery for this property.</p>
        </div>

        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
            <!-- Property Title & Category -->
            <div class="row g-3 mb-3">
                <div class="col-md-7">
                    <label for="title" class="form-label fw-semibold">Listing Title</label>
                    <input 
                        name="listing[title]" 
                        id="title" 
                        value="<%= listing.title %>" 
                        type="text" 
                        class="form-control form-control-custom" 
                        required
                    >
                    <div class="invalid-feedback">Please provide an attractive title.</div>
                </div>

                <div class="col-md-5">
                    <label for="category" class="form-label fw-semibold">Category</label>
                    <select id="category" name="listing[category]" class="form-select form-control-custom" required>
                        <option value="" disabled>Choose a category</option>
                        <option value="Trending" <%= listing.category === "Trending" ? "selected" : "" %>>Trending</option>
                        <option value="Beachfront" <%= listing.category === "Beachfront" ? "selected" : "" %>>Beachfront</option>
                        <option value="Rooms" <%= listing.category === "Rooms" ? "selected" : "" %>>Rooms</option>
                        <option value="Iconic Cities" <%= listing.category === "Iconic Cities" ? "selected" : "" %>>Iconic Cities</option>
                        <option value="Mountains" <%= listing.category === "Mountains" ? "selected" : "" %>>Mountains</option>
                        <option value="Castles" <%= listing.category === "Castles" ? "selected" : "" %>>Castles</option>
                        <option value="Amazing pools" <%= listing.category === "Amazing pools" ? "selected" : "" %>>Amazing pools</option>
                        <option value="Camping" <%= listing.category === "Camping" ? "selected" : "" %>>Camping</option>
                        <option value="Farms" <%= listing.category === "Farms" ? "selected" : "" %>>Farms</option>
                        <option value="Arctic" <%= listing.category === "Arctic" ? "selected" : "" %>>Arctic</option>
                        <option value="Domes" <%= listing.category === "Domes" ? "selected" : "" %>>Domes</option>
                        <option value="Boats" <%= listing.category === "Boats" ? "selected" : "" %>>Boats</option>
                    </select>
                </div>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label for="description" class="form-label fw-semibold">Description</label>
                <textarea 
                    name="listing[description]" 
                    id="description" 
                    rows="4" 
                    class="form-control form-control-custom" 
                    required
                ><%= listing.description %></textarea>
                <div class="invalid-feedback">Please provide a description.</div>
            </div>

            <!-- Current Image & Upload New -->
            <div class="mb-4">
                <label class="form-label fw-semibold d-block">Current Property Image</label>
                <% if(typeof originalImageUrl !== 'undefined' && originalImageUrl) { %>
                    <img src="<%= originalImageUrl %>" class="rounded-3 mb-2 shadow-sm" style="max-height: 180px; object-fit: cover;" alt="Current Image">
                <% } else if(listing.image && listing.image.url) { %>
                    <img src="<%= listing.image.url %>" class="rounded-3 mb-2 shadow-sm" style="max-height: 180px; object-fit: cover;" alt="Current Image">
                <% } %>

                <label for="image" class="form-label fw-semibold mt-2">Upload New Image File (Optional)</label>
                <input 
                    name="listing[image]" 
                    id="image" 
                    type="file" 
                    class="form-control form-control-custom mb-2" 
                    accept="image/*"
                >
                <div class="d-flex align-items-center my-2">
                    <hr class="flex-grow-1 my-0">
                    <span class="px-2 text-muted small">OR UPDATE VIA IMAGE URL</span>
                    <hr class="flex-grow-1 my-0">
                </div>
                <input 
                    name="listing[imageUrl]" 
                    id="imageUrl" 
                    type="url" 
                    class="form-control form-control-custom" 
                    placeholder="https://images.unsplash.com/... (optional)"
                >
            </div>

            <!-- Price & Location -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label for="price" class="form-label fw-semibold">Price per night (&#8377;)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light">&#8377;</span>
                        <input 
                            name="listing[price]" 
                            id="price" 
                            value="<%= listing.price %>" 
                            type="number" 
                            min="100" 
                            class="form-control form-control-custom" 
                            required
                        >
                    </div>
                </div>

                <div class="col-md-4">
                    <label for="location" class="form-label fw-semibold">City / Location</label>
                    <input 
                        name="listing[location]" 
                        id="location" 
                        value="<%= listing.location %>" 
                        type="text" 
                        class="form-control form-control-custom" 
                        required
                    >
                </div>

                <div class="col-md-4">
                    <label for="country" class="form-label fw-semibold">Country</label>
                    <input 
                        name="listing[country]" 
                        id="country" 
                        value="<%= listing.country %>" 
                        type="text" 
                        class="form-control form-control-custom" 
                        required
                    >
                </div>
            </div>

            <!-- Submit Button -->
            <div class="d-flex justify-content-end gap-2">
                <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                <button class="btn btn-danger btn-auth-submit rounded-pill px-4" style="width: auto;">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>