<% if(success && success.length){ %>
    <div class="alert alert-success alert-dismissible fade show custom-alert bg-success text-white" role="alert">
        <i class="fa-solid fa-circle-check fs-5"></i>
        <div class="flex-grow-1"><%= success %></div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if(error && error.length){ %>
    <div class="alert alert-danger alert-dismissible fade show custom-alert bg-danger text-white" role="alert">
        <i class="fa-solid fa-circle-exclamation fs-5"></i>
        <div class="flex-grow-1"><%= error %></div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>